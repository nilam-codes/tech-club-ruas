# Supabase Configuration for TECH CLUB Platform
# Replace with your actual project credentials from the Supabase Project Dashboard (Settings > API)
# NEVER put your secret service-role key here — only use the public anon key.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

